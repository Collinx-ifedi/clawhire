styles.py

components.py

api.py

Do NOT redefine any shared classes.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PURPOSE

This module creates a fully interactive terminal running inside Streamlit.

The user must feel like they are interacting with a real CLI instead of a web application.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

